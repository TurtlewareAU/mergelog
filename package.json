{
  "name": "project-journal-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "vercel-build": "npm --prefix web install && npm --prefix web run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:postgres": "node --import tsx --test test/postgres.integration.test.ts",
    "test:mcp": "tsx scripts/smoke-mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
